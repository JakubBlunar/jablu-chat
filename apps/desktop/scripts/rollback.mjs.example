#!/usr/bin/env node
// Roll the VPS back one release by swapping the *.prev manifests over
// latest*.yml / latest*.yml.sig. Copy this file to rollback.mjs
// (git-ignored), fill in the constants below, and run:
//   pnpm --filter @chat/desktop rollback

import { spawnSync } from 'node:child_process'

// ─── FILL THESE IN ────────────────────────────────────────────────────────
const HOST = 'vps.example.com'
const USER = 'REPLACE_ME'
const PASSWORD = 'REPLACE_ME'
const UPDATES_PATH = '/var/lib/jablu/updates'
// ──────────────────────────────────────────────────────────────────────────

function run(cmd, args) {
  const safeArgs = args.map((a) => (a === PASSWORD ? '<password>' : a))
  console.log(`\n$ ${cmd} ${safeArgs.join(' ')}`)
  const result = spawnSync(cmd, args, { stdio: 'inherit', shell: process.platform === 'win32' })
  if (result.status !== 0) {
    console.error(`[rollback] ${cmd} exited ${result.status}`)
    process.exit(result.status ?? 1)
  }
}

if (PASSWORD === 'REPLACE_ME') {
  console.error('[rollback] Edit apps/desktop/scripts/rollback.mjs and set HOST / USER / PASSWORD first.')
  process.exit(1)
}

const cmd = [
  `cd ${UPDATES_PATH}`,
  `swapped=0`,
  `for f in latest*.yml.prev latest*.yml.sig.prev; do`,
  `  if [ -f "$f" ]; then target="${'${f%.prev}'}"; mv -f "$f" "$target"; echo "restored $target"; swapped=$((swapped+1)); fi`,
  `done`,
  `if [ "$swapped" = 0 ]; then echo "No *.prev files to roll back to."; exit 1; fi`
].join('; ')

run('plink', ['-batch', '-pw', PASSWORD, `${USER}@${HOST}`, cmd])

console.log('\n[rollback] Done. Clients will see the previous manifest on next check.')
