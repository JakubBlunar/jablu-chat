#!/usr/bin/env node
// Per-deployment upload script. Copy this file to deploy.mjs (which is
// git-ignored), fill in the constants below, and it will be invoked
// automatically at the end of release.mjs.
//
// Requires PuTTY tools on PATH (pscp.exe + plink.exe). Install once via:
//   winget install PuTTY.PuTTY
// or download from https://www.putty.org/ .

import { spawnSync } from 'node:child_process'
import { existsSync, readdirSync } from 'node:fs'
import { dirname, join, resolve } from 'node:path'
import { fileURLToPath } from 'node:url'

// ─── FILL THESE IN ────────────────────────────────────────────────────────
const HOST = 'vps.example.com'
const USER = 'REPLACE_ME'
const PASSWORD = 'REPLACE_ME'
const UPDATES_PATH = '/var/lib/jablu/updates'
const DOWNLOADS_PATH = '/var/lib/jablu/downloads'
// ──────────────────────────────────────────────────────────────────────────

const here = dirname(fileURLToPath(import.meta.url))
const releaseDir = resolve(here, '..', 'release')

function run(cmd, args) {
  // Hide password from console output
  const safeArgs = args.map((a) => (a === PASSWORD ? '<password>' : a))
  console.log(`\n$ ${cmd} ${safeArgs.join(' ')}`)
  const result = spawnSync(cmd, args, { stdio: 'inherit', shell: process.platform === 'win32' })
  if (result.status !== 0) {
    console.error(`[deploy] ${cmd} exited ${result.status}`)
    process.exit(result.status ?? 1)
  }
}

if (PASSWORD === 'REPLACE_ME') {
  console.error('[deploy] Edit apps/desktop/scripts/deploy.mjs and set HOST / USER / PASSWORD first.')
  process.exit(1)
}

if (!existsSync(releaseDir)) {
  console.error(`[deploy] ${releaseDir} does not exist. Run release.mjs or "pnpm dist" first.`)
  process.exit(1)
}

const allFiles = readdirSync(releaseDir)
const installerPatterns = [/\.exe$/i, /\.msi$/i, /\.dmg$/i, /\.pkg$/i, /\.AppImage$/i, /\.deb$/i, /\.rpm$/i, /\.snap$/i]
const installers = allFiles.filter((f) => installerPatterns.some((r) => r.test(f)))
const manifests = allFiles.filter((f) => /^latest.*\.(ya?ml|ya?ml\.sig)$/i.test(f))

if (manifests.length === 0) {
  console.error('[deploy] No latest*.yml manifests found in release/. Did signing succeed?')
  process.exit(1)
}

// Snapshot current remote manifests for rollback (exactly one level of history).
const snapshotCmd = [
  `cd ${UPDATES_PATH}`,
  `for f in latest*.yml latest*.yml.sig; do [ -f \"$f\" ] && cp -f \"$f\" \"$f.prev\"; done`
].join('; ')

run('plink', ['-batch', '-pw', PASSWORD, `${USER}@${HOST}`, snapshotCmd])

if (installers.length > 0) {
  run('pscp', [
    '-batch',
    '-pw',
    PASSWORD,
    ...installers.map((f) => join(releaseDir, f)),
    `${USER}@${HOST}:${DOWNLOADS_PATH}/`
  ])
}

run('pscp', [
  '-batch',
  '-pw',
  PASSWORD,
  ...manifests.map((f) => join(releaseDir, f)),
  `${USER}@${HOST}:${UPDATES_PATH}/`
])

run('plink', [
  '-batch',
  '-pw',
  PASSWORD,
  `${USER}@${HOST}`,
  `echo 'Deploy complete: ' $(ls -1 ${UPDATES_PATH}/latest*.yml | wc -l) ' manifests, ' $(ls -1 ${DOWNLOADS_PATH}/*.exe ${DOWNLOADS_PATH}/*.AppImage 2>/dev/null | wc -l) ' installers'`
])

console.log('\n[deploy] Done.')
