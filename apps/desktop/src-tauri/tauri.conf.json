{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jablu",
  "version": "1.0.1",
  "identifier": "com.jablu.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @chat/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Jablu",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 560,
        "backgroundColor": "#1e1f22",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "http://127.0.0.1/api/updates/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzOTFBMDgxQjRERjBDODYKUldTR0ROKzBnYUNSRTllMUR0czl0WGdVRUd0dU5ySHJWckxPbk1EdjYyeHE0dW5TVTMyNEVXbXoK"
    }
  }
}
