# Default: treat as text, normalize to LF in the index and on checkout.
# Combined with .editorconfig (end_of_line = lf), this keeps the working tree
# stable across Windows, macOS, and Linux contributors regardless of each
# user's core.autocrlf setting.
* text=auto eol=lf

# Source / config text files — explicit for clarity
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.html      text eol=lf
*.svg       text eol=lf
*.sh        text eol=lf
*.bash      text eol=lf
*.conf      text eol=lf
.env*       text eol=lf
Dockerfile          text eol=lf
Dockerfile.*        text eol=lf
docker-compose*.yml text eol=lf

# Windows-only files that legitimately want CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Known binary types — never diff or normalize
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.eot       binary
*.mp3       binary
*.mp4       binary
*.webm      binary
*.zip       binary
*.gz        binary
*.tgz       binary
*.pdf       binary
