{
  "name": "@chat/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for building Jablu chat bots",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3"
  }
}
